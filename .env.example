# Copie para .env.local (fora do git) e preencha.
# Na Vercel: Settings → Environment Variables, com os mesmos nomes.
#
# Nenhuma leva NEXT_PUBLIC_: o navegador nunca fala com o banco.
# Sem estas variáveis o portal funciona normalmente — só o envio do quiz e a
# área do professor ficam desativados.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys
# "Publishable key" (sb_publishable_...) — usada só no login do professor
SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...) — ignora a RLS: nunca em código de cliente
SUPABASE_SECRET_KEY=

# Único e-mail com acesso ao painel /professor
PROFESSOR_EMAIL=